# Valores PADRÃO de desenvolvimento do LETRION — sem nenhum segredo real.
# Este arquivo é versionado no repositório e é carregado ANTES de
# /run/base44/app.env, que traz os segredos do dashboard e sempre vence.
#
# As chaves de IA (OPENROUTER_API_KEY, GOOGLE_API_KEY) NÃO ficam aqui:
# cadastre-as na página de segredos da plataforma e elas chegam ao serviço
# "api" pelo env_file /run/base44/app.env.

# Sem HTTPS terminado no próprio container (o TLS fica no proxy do preview).
COOKIE_SECURE=0

# Modelos usados pela Lexi no servidor.
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_MODEL=gemini-2.5-flash-lite
